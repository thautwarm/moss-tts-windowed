+// FNV-1a 64 指纹：标注 codes 文件的来源音频，用于检出「codes 与参考音频张冠李戴」。
+// （不是密码学哈希 —— 这里防的是误用/串台，不是恶意伪造。）
+static uint64_t moss_fingerprint_file(const std::string & path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        throw std::runtime_error("failed to open for fingerprint: " + path);
+    }
+    uint64_t h = 1469598103934665603ULL;
+    char buf[1 << 16];
+    while (in) {
+        in.read(buf, (std::streamsize) sizeof(buf));
+        const std::streamsize n = in.gcount();
+        for (std::streamsize i = 0; i < n; ++i) {
+            h ^= (uint64_t) (unsigned char) buf[i];
+            h *= 1099511628211ULL;
+        }
+    }
+    return h;
+}
