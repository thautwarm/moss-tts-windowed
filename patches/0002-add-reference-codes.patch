+// 读取 moss_write_codes_file 写出的文件（用于缓存参考音频的 codes，跳过 encoder）
+// 返回 false 表示「这份 codes 不可用」（magic/version/n_vq/取值/截断等任何问题），
+// 调用方据此回退到现场编码 —— 绝不因为一个坏缓存文件就让整个请求失败。
+static bool moss_read_codes_file(
+        const std::string & path,
+        std::vector<llama_token> & raw_codes,
+        size_t & raw_frames,
+        const moss_delay_config & cfg,
+        uint64_t * out_fingerprint = nullptr) {
+    try {
+        std::ifstream in(path, std::ios::binary);
+        if (!in) {
+            throw std::runtime_error("cannot open for reading");
+        }
+
+        moss_codes_header hdr;
+        moss_read_exact(in, &hdr, 1, "codes header");
+        if (hdr.magic != MOSS_CODES_MAGIC) {
+            throw std::runtime_error("wrong magic");
+        }
+        if (hdr.version != MOSS_CODES_VERSION) {
+            throw std::runtime_error(
+                    "unsupported version " + std::to_string(hdr.version) +
+                    " (this build produces/accepts v" + std::to_string(MOSS_CODES_VERSION) + ")");
+        }
+        if ((uint32_t) cfg.n_vq != hdr.n_vq) {
+            throw std::runtime_error(
+                    "quantizer count mismatch: file has " + std::to_string(hdr.n_vq) +
+                    ", model expects " + std::to_string(cfg.n_vq));
+        }
+
+        raw_frames = (size_t) hdr.n_frames;
+        raw_codes.resize((size_t) hdr.n_frames * (size_t) hdr.n_vq);
+        moss_read_exact(in, raw_codes.data(), raw_codes.size(), "codes payload");
+
+        // 取值校验：这些 code 会被当作 token_embd_audio.k（audio_vocab_size 行）的行索引
+        // 送进 ggml_get_rows，而该 kernel 不做边界检查 —— 越界值会直接越界读内存。
+        // 编码器输出的是 1024 类上的 argmax，必然落在 [0, audio_vocab_size)，
+        // 所以只要出现越界值，就说明这个文件不是本模型/本路径产出的。
+        for (size_t i = 0; i < raw_codes.size(); ++i) {
+            if (raw_codes[i] < 0 || (uint32_t) raw_codes[i] >= cfg.audio_vocab_size) {
+                throw std::runtime_error(
+                        "out-of-range code at index " + std::to_string(i) +
+                        ": " + std::to_string((long long) raw_codes[i]) +
+                        " (valid range is [0, " + std::to_string(cfg.audio_vocab_size) + "))");
+            }
+        }
+
+        if (out_fingerprint != nullptr) {
+            *out_fingerprint = hdr.source_fingerprint;
+        }
+        return true;
+    } catch (const std::exception & err) {
+        LOG_ERR("%s: unusable reference codes '%s': %s -- will re-encode instead\n",
+                __func__, path.c_str(), err.what());
+        raw_codes.clear();
+        raw_frames = 0;
+        return false;
+    }
+}
