 static uint32_t g_moss_stream_window         = 12;   // 每块推进的帧数（≈0.96 s）
 static uint32_t g_moss_stream_overlap        = 12;   // 左侧上下文帧数（≈0.96 s）
 static uint32_t g_moss_stream_lookahead      = 0;    // patch 0008：右侧前瞻帧数（0 = 有多少用多少，零等待）
+
+// patch 0012：逐帧探测客户端是否已断开（poll 不读数据，只是查 socket 事件）
+static bool moss_stream_client_gone() {
+    if (g_moss_stream_fd < 0) {
+        return false;
+    }
+    struct pollfd pfd;
+    pfd.fd      = g_moss_stream_fd;
+    pfd.events  = POLLIN;
+    pfd.revents = 0;
+    if (::poll(&pfd, 1, 0) <= 0) {
+        return false;
+    }
+#ifdef POLLRDHUP
+    if (pfd.revents & POLLRDHUP) {
+        return true;
+    }
+#endif
+    if (pfd.revents & (POLLHUP | POLLERR | POLLNVAL)) {
+        return true;
+    }
+    // 协议是"请求发完就不再发"，所以对端可读 = 已经 EOF
+    return (pfd.revents & POLLIN) != 0;
+}
 static long long g_moss_serve_max_new_tokens = 448;  // 非流式整段解码上限（0 = 不限）
