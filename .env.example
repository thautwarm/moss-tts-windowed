# moss-tts-windowed 运行时配置（改完 docker compose up -d 生效）

# 对外端口
TTSPORT=6677

# 模型 GGUF 所在目录（宿主路径，挂到容器 /models）
MOSS_MODELS_HOST=./models
MOSS_MODEL_FILE=moss_tts_v15_firstclass_q4_k_m_aq8.gguf
MOSS_DECODER_FILE=moss_tts_audio_decoder_f16.gguf

# 合成参数（服务端固定，不通过请求暴露；Delay-8B 官方推荐值）
MOSS_LANGUAGE=zh
MOSS_AUDIO_TEMPERATURE=1.7
MOSS_AUDIO_TOP_P=0.8
MOSS_AUDIO_TOP_K=25
MOSS_AUDIO_REPETITION_PENALTY=1.0

# 流式解码窗口（1 帧 = 0.08 s）：窗口 = WINDOW + 2*OVERLAP 帧
# WINDOW 越小首字节越快、接缝越多；OVERLAP 越大越接近整段解码、越费显存
MOSS_STREAM_WINDOW=32
MOSS_STREAM_OVERLAP=40
MOSS_STREAM_LOOKAHEAD=0

# backbone context：超出行数后滑窗（只丢最老的音频行，文本前缀永不淘汰）
MOSS_CTX_ROWS=6000
MOSS_CTX_KEEP=2048

# prefill 分块：pp buffer ∝ ubatch，整段 prefill 会在 8 GB 卡上 OOM
MOSS_PREFILL_UBATCH=384
MOSS_PREFILL_BUDGET_MIB=1000

# 输入上限（字），超出截断并在响应头 X-Input-Truncated 标注
MOSS_MAX_INPUT_CHARS=2048

# 并发：daemon 单 slot，超出队列或等待超时返回 503 + Retry-After
MOSS_QUEUE_MAX=8
MOSS_QUEUE_WAIT=60

# 调试开关：1 = 日志里记录请求文本
MOSS_LOG_TEXT=0

# 1 = 非流式 /v1/audio/speech 返回 400（本部署只对外保证流式）
MOSS_DISABLE_NONSTREAM=1
