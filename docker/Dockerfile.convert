# 转换专用镜像：HF 权重 -> GGUF（只在量化时用一次，服务运行期不碰它）
#
# 转换是**纯 CPU** 的（只做 dtype 转换 + 张量搬运），不需要 CUDA，
# 所以用 python:3.12-slim + CPU 版 torch —— 彻底脱离旧的私有基础镜像。
#
# 体积对比：
#   旧（FROM 私有基础镜像）  15.2 GB（借来的 CUDA torch）
#   新（本文件）              ~1.3 GB（CPU torch 188MB）
#
# 需要走代理时（daemon 的代理只对 docker pull 生效，build 不继承）：
#   docker build -f docker/Dockerfile.convert -t moss-tts-convert:latest \
#     --build-arg HTTPS_PROXY=http://<宿主IP>:<端口> docker/
FROM python:3.12-slim

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG http_proxy
ARG https_proxy
ARG no_proxy

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# CPU 版 torch（约 188 MB；CUDA 版要 2.5 GB+ 而且这里用不上）。
# 国内替代源（若上面的官方源不通）：
#   pip install --no-cache-dir --find-links https://mirrors.aliyun.com/pytorch-wheels/cpu/ torch
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch \
    && pip install --no-cache-dir \
         "transformers>=4.40" numpy safetensors sentencepiece

WORKDIR /fork
